#include <stdio.h>

struct Student {
    int id;
    char name[50];
};

int main() {
    struct Student s[100];
    int n, add, i, total;

    printf("Enter number of existing records: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of Student %d\n", i + 1);
        printf("ID: ");
        scanf("%d", &s[i].id);
        printf("Name: ");
        scanf(" %[^\n]", s[i].name);
    }

    printf("\nEnter number of new records to add: ");
    scanf("%d", &add);

    for (i = n; i < n + add; i++) {
        printf("\nEnter details of New Student %d\n", i + 1);
        printf("ID: ");
        scanf("%d", &s[i].id);
        printf("Name: ");
        scanf(" %[^\n]", s[i].name);
    }

    total = n + add;

    printf("\n--- Updated Student Records ---\n");
    for (i = 0; i < total; i++) {
        printf("Student %d: ID = %d, Name = %s\n",
               i + 1, s[i].id, s[i].name);
    }

    return 0;
}
