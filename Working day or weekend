#include <stdio.h>

int main() {
    int day;

    /*
      Day mapping:
      1 - Monday
      2 - Tuesday
      3 - Wednesday
      4 - Thursday
      5 - Friday
      6 - Saturday
      7 - Sunday
    */

    printf("Enter day number (1–7): ");
    scanf("%d", &day);

    if (day >= 1 && day <= 5) {
        printf("It is a Working Day.\n");
    } 
    else if (day == 6 || day == 7) {
        printf("It is a Weekend.\n");
    } 
    else {
        printf("Invalid day number.\n");
    }

    return 0;
}
