#include <stdio.h>

float calculateAverage(float a, float b, float c) {
    return (a + b + c) / 3;
}

int main() {
    float n1, n2, n3, avg;

    printf("Enter three numbers: ");
    scanf("%f %f %f", &n1, &n2, &n3);

    avg = calculateAverage(n1, n2, n3);

    printf("Average = %.2f\n", avg);

    return 0;
}
