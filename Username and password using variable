#include <stdio.h>
#include <string.h>

struct Login {
    char username[50];
    char password[50];
};

int main() {
    struct Login stored, input;

    strcpy(stored.username, "admin");
    strcpy(stored.password, "12345");

    printf("Enter username: ");
    scanf("%s", input.username);

    printf("Enter password: ");
    scanf("%s", input.password);

    if (strcmp(stored.username, input.username) == 0 &&
        strcmp(stored.password, input.password) == 0) {
        printf("Login successful!\n");
    } else {
        printf("Invalid username or password.\n");
    }

    return 0;
}
