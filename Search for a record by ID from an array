#include <stdio.h>

struct Record {
    int id;
    char name[50];
};

int main() {
    struct Record r[100];
    int n, i, searchId, found = 0;

    printf("Enter number of records: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of Record %d\n", i + 1);

        printf("ID: ");
        scanf("%d", &r[i].id);

        printf("Name: ");
        scanf(" %[^\n]", r[i].name);
    }

    printf("\nEnter ID to search: ");
    scanf("%d", &searchId);

    for (i = 0; i < n; i++) {
        if (r[i].id == searchId) {
            printf("\n--- Record Found ---\n");
            printf("ID   : %d\n", r[i].id);
            printf("Name : %s\n", r[i].name);
            found = 1;
            break;
        }
    }

    if (!found) {
        printf("\nRecord with ID %d not found.\n", searchId);
    }

    return 0;
}
