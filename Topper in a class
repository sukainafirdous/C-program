#include <stdio.h>

struct Student {
    char name[50];
    int marks;
};

int main() {
    int n, i, topperIndex = 0;

    printf("Enter number of students: ");
    scanf("%d", &n);

    struct Student s[n];

    for (i = 0; i < n; i++) {
        printf("\nEnter name of student %d: ", i + 1);
        scanf("%s", s[i].name);

        printf("Enter marks of student %d: ", i + 1);
        scanf("%d", &s[i].marks);
    }

    for (i = 1; i < n; i++) {
        if (s[i].marks > s[topperIndex].marks) {
            topperIndex = i;
        }
    }

    printf("\nTopper of the class:\n");
    printf("Name: %s\n", s[topperIndex].name);
    printf("Marks: %d\n", s[topperIndex].marks);

    return 0;
}
