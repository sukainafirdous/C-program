#include <stdio.h>

struct Record {
    int id;
    char name[50];
};

int main() {
    struct Record r[100];
    int n, i;

    printf("Enter number of records: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of Record %d\n", i + 1);

        printf("ID: ");
        scanf("%d", &r[i].id);

        printf("Name: ");
        scanf(" %[^\n]", r[i].name);
    }

    printf("\nTotal number of records stored: %d\n", n);

    return 0;
}
