#include <stdio.h>

int main() {
    int days, i;
    int workedDays = 0;
    int attendance;

    printf("Enter number of days in the month: ");
    scanf("%d", &days);

    printf("Enter attendance for each day (1 = Worked, 0 = Not worked):\n");
    for (i = 1; i <= days; i++) {
        scanf("%d", &attendance);
        if (attendance == 1) {
            workedDays++;
        }
    }

    printf("Total number of days worked in the month = %d\n", workedDays);

    return 0;
}
